# ═══════════════════════════════════════════════
# RadioZec — Environment Configuration
# ═══════════════════════════════════════════════

# ── Zkool / Zcash ─────────────────────────────
# GraphQL endpoint for the Zkool wallet daemon
GQL_URL=http://127.0.0.1:8000/graphql
ZKOOL_FAST_SYNC="false"

# Which Zkool account to scan for donations.
# Run `cd server && npm run setup:zkool` to create an account and get the ID.
ZKOOL_ACCOUNT_ID=1

# ── Network ───────────────────────────────────
NETWORK="main"
USE_HTTPS="false"
PORT=3000

# ── Auth ──────────────────────────────────────
JWT_SECRET_KEY="change-me-to-a-random-64-char-hex-string"

# ── Pricing (defaults, overridable via admin panel) ──
QUEUE_VIDEO_PRICE=0.001
SKIP_VIDEO_PRICE=0.005
SCAN_INTERVAL_MS=30000

# ── Admin seed credentials (first run only) ──
SEED_USERNAME="admin"
SEED_PASSWORD="changeme123"

# ── Icecast ───────────────────────────────────
# Public-facing stream URL used by the frontend <audio> element.
# In prod, set to your public domain: https://yourdomain.com/radio
ICECAST_URL=http://localhost:8001/radio

# ── Liquidsoap telnet control ─────────────────
LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_PORT=1234

# ── Media download ────────────────────────────
MEDIA_DIR=./media
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192
MEDIA_CLEANUP_HOURS=24

# ── MediaMTX (OPTIONAL — live streaming from OBS) ──
# Only needed if you want to use the "Go Live" feature.
# If MediaMTX is not running, RadioZec works fine without it.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=/live/zecradio-live/index.m3u8
LIVE_STREAM_KEY=zecradio-live
