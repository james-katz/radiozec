# Zkool GraphQL
GQL_URL=http://127.0.0.1:8000/graphql
ZKOOL_FAST_SYNC="false"

# Network
NETWORK="test"
USE_HTTPS="false"
PORT=3000

# Auth
JWT_SECRET_KEY="change-me-to-a-random-64-char-hex-string"

# Defaults (can be overridden via admin panel)
QUEUE_VIDEO_PRICE=0.001
SKIP_VIDEO_PRICE=0.005
SCAN_INTERVAL_MS=30000

# Admin seed credentials (first run only)
SEED_USERNAME="admin"
SEED_PASSWORD="changeme123"

# Icecast stream URL (public-facing, used by frontend <audio> element)
ICECAST_URL=http://localhost:8001/radio

# Liquidsoap telnet control interface
LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_PORT=1234

# Media download settings
MEDIA_DIR=./media
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192
MEDIA_CLEANUP_HOURS=24

# MediaMTX (live streaming from OBS)
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=/hls/zecradio-live/index.m3u8
LIVE_STREAM_KEY=zecradio-live
